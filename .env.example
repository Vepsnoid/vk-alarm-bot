# Скопируйте этот файл в .env (в корне проекта) и заполните значения.
# Файл .env в git не попадает.

# --- обязательное ---
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# --- токены VK и Max (можно задать позже в интерфейсе «Настройки») ---
# Токен VK: https://dev.vk.com → Ваше приложение → «Ключи доступа» (вид: vk1.a.XXXX…).
# Оставьте пустым, пока не получите токен: тогда проверки просто не запускаются,
# а в логе будет понятное «VK token is not configured».
VK_SERVICE_TOKEN=
# Токен бота Max (создаётся у @MasterBot в Max).
MAX_BOT_TOKEN=

# --- ИИ (необязательно) ---
# AI_PROVIDER=gigachat — GigaChat, либо openai для любого OpenAI-совместимого API
AI_PROVIDER=gigachat
AI_API_KEY=
AI_MODEL=GigaChat
AI_API_BASE=https://api.openai.com/v1

# --- GigaChat напрямую (если не через AI_API_KEY) ---
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat

# --- прочее ---
# DATABASE_URL=sqlite+aiosqlite:///./vk_alarm.db
# Сколько новых постов забирать на источник за одну проверку (по умолчанию 200).
# Для «шумных» новостных пабликов лимит можно поднять: если новостей пришло
# больше, в журнал потока и колокольчик попадёт предупреждение о пропущенных
# самых старых постах.
# MAX_NEW_POSTS_PER_RUN=200
# Сколько постов из очереди повторной отправки обрабатывать за прогон (по умолчанию 50).
# MAX_RETRIES_PER_RUN=50

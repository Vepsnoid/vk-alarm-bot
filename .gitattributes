# Нормализация переводов строк. В репозитории — LF, чтобы shell-скрипты и
# конфиги корректно работали на Linux-сервере после клонирования.
* text=auto

*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.py      text eol=lf
*.txt     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf

*.png     binary

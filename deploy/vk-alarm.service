[Unit]
Description=VK Alarm Bot — monitor VK and forward to Max
Documentation=https://github.com/Vepsnoid/vk-alarm-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data

# База SQLite создаётся в рабочем каталоге, поэтому запускаем из backend/
WorkingDirectory=/opt/vk-alarm-bot/backend
# Обратите внимание: .env НЕ передаётся сюда через EnvironmentFile — приложение
# само читает /opt/vk-alarm-bot/.env, и переменные окружения имели бы приоритет
# над файлом (тогда токены, сохранённые из веб-интерфейса, перестали бы
# применяться до перезапуска сервиса).

ExecStart=/opt/vk-alarm-bot/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=5
# Длинные проверки источников: даём процессу время корректно завершиться
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
